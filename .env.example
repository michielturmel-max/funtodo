# Public URL of the app, used for redirects.
APP_URL=http://localhost:3000

# SQLite file. Swap this for a DATABASE_URL when moving to Postgres.
DATABASE_FILE=./data/funtodo.db

# Admin account, created automatically when the database is empty.
ADMIN_USERNAME=beheerder
ADMIN_NAME=Beheerder
ADMIN_PASSWORD=kies-een-lang-wachtwoord

# Optioneel: pushmeldingen. Zonder deze regels maakt de app zelf een sleutelpaar
# in de map van DATABASE_FILE (data/vapid.json). Zet ze in productie vast.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:beheerder@example.com
